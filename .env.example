# ============================================================================
# Claude Desktop on Mobile - Environment Configuration
# ============================================================================
# This configuration is specifically tuned for using Claude Desktop on mobile
# devices via remote desktop streaming. It prioritizes responsiveness and
# readability over visual perfection.
# ============================================================================

# Required webtop login credentials
WEBTOP_USER=admin
WEBTOP_PASSWORD=change-this-to-a-long-random-password

# ---- Runtime Settings ----
PUID=1000
PGID=1000
TZ=Asia/Tehran
WEBTOP_HTTPS_BIND=0.0.0.0

# ============================================================================
# Claude Desktop Mobile Profile
# Optimized for fast UI responsiveness and readable code display
# ============================================================================

# Stream Resolution: 1280x720 is perfect for Claude on mobile
# - Readable code text at normal zoom
# - Fast H.264 encoding
# - Comfortable for touch interaction
# Alternatives: 960x540 (ultra-fast), 1920x1080 (high quality, slower)
MAX_RES=1280x720

# Stream Frame Rate: 24 fps
# - Feels smooth to human eye
# - 40% less bandwidth than 30 fps
# - Input feels responsive
SELKIES_FRAMERATE=24

# Video Quality (H.264 CRF): 30
# - Balanced quality/speed tradeoff
# - Fast encoding on mobile hardware
# - Text remains readable (very important for Claude)
SELKIES_H264_CRF=30

# Encoder: x264enc-striped
# - Lowest latency encoder
# - Optimized for streaming
# - Fast encoding on modest hardware
SELKIES_ENCODER=x264enc-striped

# ---- Input & Rendering Optimization ----
# These settings make Claude Desktop feel responsive on touch

# Use browser-side CSS scaling (faster than server-side)
SELKIES_USE_CSS_SCALING=true

# Use browser mouse cursors (lighter rendering)
SELKIES_USE_BROWSER_CURSORS=true

# Prioritize visual feedback speed over perfect rendering
SELKIES_USE_PAINT_OVER_QUALITY=true

# Force aligned resolution for cleaner text rendering
SELKIES_FORCE_ALIGNED_RESOLUTION=true

# DPI scaling (96 = standard for most Android displays)
SELKIES_SCALING_DPI=96

# ---- Disable Resource-Heavy Extras ----
# These are turned off to reduce bandwidth and CPU on mobile

SELKIES_AUDIO_ENABLED=false              # Not needed for Claude Desktop work
SELKIES_MICROPHONE_ENABLED=false         # Use device mic if needed
SELKIES_GAMEPAD_ENABLED=false            # Not relevant
SELKIES_ENABLE_BINARY_CLIPBOARD=false    # Text-only clipboard
SELKIES_CLIPBOARD_ENABLED=true           # Keep text clipboard enabled
SELKIES_FILE_TRANSFERS=none              # Use clipboard or cloud storage
SELKIES_ENABLE_SHARING=false             # Single user only
SELKIES_SECOND_SCREEN=false              # Mobile screen is limited

# ---- Minimal Mobile UI ----
# Show only essential controls for Claude Desktop work on mobile

SELKIES_UI_SHOW_CORE_BUTTONS=false       # Hide unnecessary controls
SELKIES_UI_SIDEBAR_SHOW_AUDIO_SETTINGS=false
SELKIES_UI_SIDEBAR_SHOW_FILES=false      # Use file manager in Claude if needed
SELKIES_UI_SIDEBAR_SHOW_SHARING=false
SELKIES_UI_SIDEBAR_SHOW_GAMEPADS=false
SELKIES_UI_SIDEBAR_SHOW_STATS=false      # Hide performance stats
SELKIES_UI_SIDEBAR_SHOW_GAMING_MODE=false

# Keep only essential controls visible
SELKIES_UI_SIDEBAR_SHOW_SCREEN_SETTINGS=true   # Adjust display
SELKIES_UI_SIDEBAR_SHOW_VIDEO_SETTINGS=true    # Adjust stream quality
SELKIES_UI_SIDEBAR_SHOW_CLIPBOARD=true         # Copy/paste support
SELKIES_UI_SIDEBAR_SHOW_TRACKPAD=true          # Trackpad mode (recommended)
SELKIES_UI_SIDEBAR_SHOW_FULLSCREEN=true        # Maximize screen space
SELKIES_UI_SIDEBAR_SHOW_KEYBOARD_BUTTON=true   # Virtual keyboard

# ---- System Resources ----
# Adjust based on your server's capabilities

CPU_LIMIT=4                 # Use 4 CPU cores
MEMORY_LIMIT=4G             # Allocate 4GB RAM

# ============================================================================
# Performance Presets (uncomment one to switch profiles)
# ============================================================================

# --- ULTRA-FAST (Weak 3G/4G Connection) ---
# Use this for slow or unreliable mobile networks
# Prioritizes responsiveness over quality
# MAX_RES=960x540
# SELKIES_FRAMERATE=20
# SELKIES_H264_CRF=32

# --- BALANCED (Recommended - Good 4G/WiFi) ---
# Already set above - good for typical usage

# --- HIGH QUALITY (Strong WiFi/5G) ---
# Use this for fast, reliable connections
# Code text will be sharper and easier to read
# MAX_RES=1920x1080
# SELKIES_FRAMERATE=30
# SELKIES_H264_CRF=28
# CPU_LIMIT=8
# MEMORY_LIMIT=8G
